{
  "manifest_version": 3,
  "name": "Baidu Pan Agent Connector (Unofficial)",
  "version": "0.6.2",
  "description": "Unofficial Agent connector for pan.baidu.com with status-only UI, bridge task execution, and local file upload.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Baidu Pan Agent Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://pan.baidu.com/*",
    "https://yun.baidu.com/*",
    "https://*.pcs.baidu.com/*",
    "http://127.0.0.1:27865/*",
    "http://localhost:27865/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pan.baidu.com/*"],
      "js": ["crawl.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://pan.baidu.com/*"]
    }
  ]
}
